---
import { useTranslations } from "../i18n/utils";

const t = useTranslations(Astro.currentLocale);

const sources = [
  "/images/gorilla-hoodie.png",
  "/images/coffee.png",
  "/images/tshirt.png",
  "/images/wall.png",
  "/images/totebag.png",
  "/images/poster.png",
];

const images = sources.map((src, i) => ({ src, alt: t.gallery.alts[i] }));
---

<div class="gallery">
  {
    images.map((image) => (
      <div class="cell">
        <img src={image.src} alt={image.alt} loading="lazy" />
      </div>
    ))
  }
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    max-width: 1728px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 80px) clamp(48px, 8vw, 120px);
  }

  .cell {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .cell img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .cell:hover img {
    transform: scale(1.08);
  }

  @media (prefers-reduced-motion: reduce) {
    .cell img {
      transition: none;
    }
  }

  @media (max-width: 640px) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
