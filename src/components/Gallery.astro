---
const images = [
  { src: "/images/gorilla-hoodie.png", alt: "Gorilla hoodie" },
  { src: "/images/coffee.png", alt: "Branded coffee cup" },
  { src: "/images/tshirt.png", alt: "Gorilla t-shirt" },
  { src: "/images/wall.png", alt: "Street mural" },
  { src: "/images/totebag.png", alt: "Branded tote bag" },
  { src: "/images/poster.png", alt: "Street poster" },
];
---

<div class="gallery">
  {
    images.map((image) => (
      <div class="cell">
        <img src={image.src} alt={image.alt} loading="lazy" />
      </div>
    ))
  }
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    max-width: 1728px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 80px) clamp(48px, 8vw, 120px);
  }

  .cell {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .cell img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  @media (max-width: 640px) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
