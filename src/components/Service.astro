---
interface Props {
  number: string;
  title: string;
  defaultOpen?: boolean;
  items: string[];
}

const { number, title, defaultOpen = false, items } = Astro.props;
---

<div class:list={["service", { open: defaultOpen }]}>
  <div class="heading">
    <span class="number">{number}</span>
    <p class="title">{title}</p>
  </div>
  <div class="items-track">
    <ul class="items">
      {items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>
</div>

<style>
  .service {
    --ease: cubic-bezier(0.4, 0, 0.2, 1);
    --duration: 0.4s;

    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 36px;
    width: 100%;
    padding: clamp(32px, 4vw, 50px) 0 clamp(32px, 5vw, 60px);
    border-bottom: 1px solid var(--border-light);
    transition:
      background-color var(--duration) var(--ease),
      border-color var(--duration) var(--ease),
      padding var(--duration) var(--ease);
  }

  .service.open {
    background: var(--bg-light);
    border-bottom-color: transparent;
    padding: clamp(32px, 4vw, 50px) clamp(24px, 6vw, 110px) clamp(32px, 5vw, 60px) clamp(20px, 4vw, 40px);
  }

  .heading {
    display: flex;
    align-items: flex-start;
    gap: 24px;
  }

  .number {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 12px;
    color: var(--text-heading-light);
    transition: color var(--duration) var(--ease);
  }

  .open .number {
    color: var(--text-heading-dark);
  }

  .title {
    font-family: var(--font-heading);
    font-size: clamp(1.625rem, 1.329rem + 1.32vw, 2.75rem);
    line-height: 1.45;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--text-heading-light);
    transition: color var(--duration) var(--ease);
  }

  .open .title {
    color: var(--text-heading-dark);
  }

  /* Grid 0fr -> 1fr collapses/reveals smoothly regardless of the actual
     content height — a fixed max-height transition animates at a
     constant rate unrelated to how much content there actually is,
     which reads as an abrupt, uneven snap. */
  .items-track {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--duration) var(--ease);
  }

  .open .items-track {
    grid-template-rows: 1fr;
  }

  .items {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 24px;
    color: var(--text-body-light);
    margin: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      opacity calc(var(--duration) * 0.6) var(--ease),
      color var(--duration) var(--ease);
  }

  .open .items {
    color: var(--text-body-dark);
    opacity: 1;
    transition-delay: calc(var(--duration) * 0.15), 0s;
  }

  .items li {
    margin-left: 24px;
  }
</style>
