---
import Service from "./Service.astro";
import { useTranslations } from "../i18n/utils";

const t = useTranslations(Astro.currentLocale);
---

<section class="what-we-do" id="services">
  <div class="intro">
    <h2 class="title">{t.whatWeDo.title[0]}<br />{t.whatWeDo.title[1]}</h2>
    <p class="copy">
      {t.whatWeDo.copy[0]}
      <br /><br />
      {t.whatWeDo.copy[1]}
    </p>
  </div>
  <div class="services">
    {t.whatWeDo.services.map((service, i) => <Service {...service} defaultOpen={i === 0} />)}
  </div>
</section>

<script>
  const container = document.querySelector<HTMLElement>(".services");
  const rows = container ? [...container.querySelectorAll<HTMLElement>(".service")] : [];

  container?.addEventListener("pointerover", (event) => {
    const row = (event.target as HTMLElement).closest(".service");
    if (!row) return;
    rows.forEach((el) => el.classList.toggle("open", el === row));
  });

  container?.addEventListener("pointerleave", () => {
    rows.forEach((el, i) => el.classList.toggle("open", i === 0));
  });
</script>

<style>
  .what-we-do {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: clamp(32px, 6vw, 64px);
    padding: clamp(48px, 8vw, 120px) clamp(20px, 5vw, 80px);
    max-width: 1728px;
    margin: 0 auto;
    background: var(--bg-dark);
  }

  .intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 36px;
    max-width: 446px;
  }

  .title {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 1.184rem + 5.85vw, 7.5rem);
    line-height: 0.83;
    letter-spacing: -0.05em;
    text-transform: uppercase;
    color: var(--text-heading-light);
  }

  .copy {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 24px;
    color: var(--text-body-light);
  }

  .services {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    max-width: 768px;
  }
</style>
