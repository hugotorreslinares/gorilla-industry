---
import { useTranslations } from "../i18n/utils";

const t = useTranslations(Astro.currentLocale);
---

<div class="scroll">
  <p>{t.scroll}</p>
  <span class="line"></span>
</div>

<style>
  .scroll {
    position: absolute;
    left: 50%;
    bottom: -48px;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .scroll p {
    font-family: "Space Mono", monospace;
    font-size: 9px;
    line-height: 13.5px;
    letter-spacing: 1.62px;
    color: var(--bg-light);
    white-space: nowrap;
  }

  .scroll .line {
    width: 1px;
    height: 48px;
    background: var(--bg-light);
  }

  @media (max-width: 640px) {
    .scroll {
      display: none;
    }
  }
</style>
