---
import Button from "./Button.astro";
import DecorFrame from "./DecorFrame.astro";
import { useTranslations } from "../i18n/utils";

const t = useTranslations(Astro.currentLocale);
---

<section class="about" id="about">
  <div class="fill" aria-hidden="true"></div>
  <DecorFrame>
    <img class="bg" src="/images/about-bg.svg" alt="" aria-hidden="true" />
  </DecorFrame>

  <div class="inner">
    <h2 class="headline">
      <span class="dark">{t.about.headline.accentWord}</span><span>{t.about.headline.restOfLine1}</span><br />
      {t.about.headline.line2}<br />
      {t.about.headline.line3}<br />
      {t.about.headline.line4}
    </h2>
    <div class="content">
      <p class="copy">
        {t.about.copy[0]}
        <br /><br />
        {t.about.copy[1]}
      </p>
      <Button label={t.about.cta} variant="onDark" />
    </div>
  </div>
</section>

<style>
  .about {
    position: relative;
    overflow: hidden;
    background: var(--bg-dark);
    padding: clamp(64px, 12vw, 160px) clamp(20px, 5vw, 80px) clamp(48px, 10vw, 120px);
  }

  .bg {
    position: absolute;
    left: -18.257px;
    top: 0;
    width: 1816.257px;
    max-width: none;
  }

  /*
   * about-bg.svg is rendered at its native 1816px width inside the fixed
   * 1728px DecorFrame (see DESIGN.md) so the wave shape stays pixel-exact
   * to Figma. That means it does NOT stretch to cover very wide viewports
   * (~>1860px) — without this fill, the dark section background shows
   * through on the sides past where the image ends. This solid layer
   * starts just below the wave's lowest dip (~415px at the 1728 reference
   * frame) and spans the full section width, so the area below the wave
   * is always solid yellow edge-to-edge regardless of viewport width.
   */
  .fill {
    position: absolute;
    top: 420px;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--bg-light);
  }

  @media (max-width: 1200px) {
    .about :global(.decor-frame),
    .fill {
      display: none;
    }

    .about {
      background: var(--bg-light);
    }
  }

  @media (min-width: 1201px) {
    .about {
      /* clears the about-bg.svg wave (transparent above it, ~415px tall at
         the 1728px reference frame) with margin so the headline always
         starts on solid yellow, matching the Figma composition. */
      padding-top: clamp(440px, 37.73vw, 652px);
      padding-bottom: clamp(160px, 20.25vw, 350px);
    }
  }

  .inner {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: clamp(32px, 6vw, 64px);
    max-width: 1568px;
    margin: 0 auto;
  }

  .headline {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 1.184rem + 5.85vw, 7.5rem);
    line-height: 0.83;
    letter-spacing: -0.05em;
    text-transform: uppercase;
    color: var(--text-body-light);
  }

  .headline .dark {
    color: var(--text-body-dark);
  }

  .content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(24px, 3vw, 40px);
    max-width: 446px;
  }

  .copy {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 24px;
    color: var(--text-body-dark);
  }
</style>
