---
import Button from "./Button.astro";
import DecorFrame from "./DecorFrame.astro";
---

<section class="about" id="about">
  <DecorFrame>
    <img class="bg" src="/images/about-bg.svg" alt="" aria-hidden="true" />
  </DecorFrame>

  <div class="inner">
    <h2 class="headline">
      <span class="dark">Bold</span><span> ideas</span><br />
      built to<br />
      outlast<br />
      trends.
    </h2>
    <div class="content">
      <p class="copy">
        We are a creative design studio obsessed with the space between art and commerce. Every project begins
        with one fundamental question: what does this brand need to feel like?
        <br /><br />
        We build brand systems, digital products and visual experiences for clients who understand that design is
        not an expense — it's the product.
      </p>
      <Button label="START A PROJECT" variant="onDark" />
    </div>
  </div>
</section>

<style>
  .about {
    position: relative;
    overflow: hidden;
    background: var(--bg-dark);
    padding: clamp(64px, 12vw, 160px) clamp(20px, 5vw, 80px) clamp(48px, 10vw, 120px);
  }

  .bg {
    position: absolute;
    left: -18.257px;
    top: 0;
    width: 1816.257px;
    max-width: none;
  }

  @media (max-width: 1200px) {
    .about :global(.decor-frame) {
      display: none;
    }

    .about {
      background: var(--bg-light);
    }
  }

  @media (min-width: 1201px) {
    .about {
      /* clears the about-bg.svg wave (transparent above it, ~415px tall at
         the 1728px reference frame) with margin so the headline always
         starts on solid yellow, matching the Figma composition. */
      padding-top: clamp(440px, 37.73vw, 652px);
      padding-bottom: clamp(160px, 20.25vw, 350px);
    }
  }

  .inner {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: clamp(32px, 6vw, 64px);
    max-width: 1568px;
    margin: 0 auto;
  }

  .headline {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 1.184rem + 5.85vw, 7.5rem);
    line-height: 0.83;
    letter-spacing: -0.05em;
    text-transform: uppercase;
    color: var(--text-body-light);
  }

  .headline .dark {
    color: var(--text-body-dark);
  }

  .content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(24px, 3vw, 40px);
    max-width: 446px;
  }

  .copy {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 24px;
    color: var(--text-body-dark);
  }
</style>
