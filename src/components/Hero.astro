---
import Button from "./Button.astro";
import ScrollIndicator from "./ScrollIndicator.astro";
import DecorFrame from "./DecorFrame.astro";
import { useTranslations } from "../i18n/utils";

const t = useTranslations(Astro.currentLocale);
---

<section class="hero" id="hero">
  <DecorFrame>
    <img class="doodle" src="/images/hero-doodle.svg" alt="" aria-hidden="true" />

    <canvas class="liana-canvas" aria-hidden="true"></canvas>

    <div class="liana liana-static liana-1" aria-hidden="true">
      <div class="liana-1-rotate">
        <img src="/images/liana-1.svg" alt="" />
      </div>
    </div>
    <img class="liana liana-static liana-2" src="/images/liana-2.svg" alt="" aria-hidden="true" />
    <img class="liana liana-static liana-3" src="/images/liana-3.svg" alt="" aria-hidden="true" />
  </DecorFrame>

  <div class="content">
    <div class="text">
      <h1>{t.hero.heading[0]}<br />{t.hero.heading[1]}</h1>
      <p class="subtitle">{t.hero.subtitle}</p>
    </div>
    <Button label={t.hero.cta} variant="onLight" />
  </div>

  <ScrollIndicator />
</section>

<script>
  // Verlet-integrated hanging ropes on a canvas, standing in for the 3
  // liana SVGs on large desktop screens only. Below 1200px (and under
  // prefers-reduced-motion) the static SVGs stay untouched instead —
  // see the CSS below and DESIGN.md.
  const canvas = document.querySelector<HTMLCanvasElement>(".liana-canvas");
  const desktopQuery = window.matchMedia("(min-width: 1200px)");
  const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (canvas) {
    const ctx = canvas.getContext("2d")!;

    const REFERENCE_WIDTH = 1728;
    const CANVAS_HEIGHT = 650;

    const CONFIG = {
      gravity: 0.15,
      friction: 0.96,
      bounceDistance: 110,
      ropes: [
        { xFraction: 0.186, points: 16, spacing: 34, width: 5, hue: 80 },
        { xFraction: 0.523, points: 13, spacing: 30, width: 2.5, hue: 95 },
        { xFraction: 0.873, points: 15, spacing: 32, width: 3.5, hue: 70 },
      ],
    };

    interface Point {
      x: number;
      y: number;
      oldX: number;
      oldY: number;
    }

    class Rope {
      points: Point[] = [];
      spacing: number;
      width: number;
      color: string;

      constructor(startX: number, count: number, spacing: number, width: number, hue: number) {
        this.spacing = spacing;
        this.width = width;
        this.color = `hsl(${hue}, 22%, 30%)`;
        for (let i = 0; i < count; i++) {
          // A little random jitter so the rope doesn't rest as a
          // mathematically perfect straight line — real vines never do.
          const jitter = i === 0 ? 0 : (Math.random() - 0.5) * 10;
          const x = startX + jitter;
          this.points.push({ x, y: i * spacing, oldX: x, oldY: i * spacing });
        }
      }

      update(mouseX: number | null, mouseY: number | null, mouseVX: number, mouseVY: number) {
        this.points.forEach((p, index) => {
          if (index === 0) return; // anchored at the top

          const vx = (p.x - p.oldX) * CONFIG.friction;
          const vy = (p.y - p.oldY) * CONFIG.friction;
          p.oldX = p.x;
          p.oldY = p.y;

          p.x += vx;
          p.y += vy + CONFIG.gravity;

          if (mouseX !== null && mouseY !== null) {
            const dx = p.x - mouseX;
            const dy = p.y - mouseY;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < CONFIG.bounceDistance) {
              const force = (CONFIG.bounceDistance - dist) / CONFIG.bounceDistance;
              p.x += mouseVX * force * 0.5;
              p.y += mouseVY * force * 0.5;
            }
          }
        });

        for (let pass = 0; pass < 5; pass++) {
          for (let i = 0; i < this.points.length - 1; i++) {
            const p1 = this.points[i];
            const p2 = this.points[i + 1];
            const dx = p2.x - p1.x;
            const dy = p2.y - p1.y;
            const dist = Math.sqrt(dx * dx + dy * dy) || 1;
            const error = this.spacing - dist;
            const percent = error / dist / 2;
            const offsetX = dx * percent;
            const offsetY = dy * percent;

            if (i === 0) {
              p2.x += offsetX * 2;
              p2.y += offsetY * 2;
            } else {
              p1.x -= offsetX;
              p1.y -= offsetY;
              p2.x += offsetX;
              p2.y += offsetY;
            }
          }
        }
      }

      draw(context: CanvasRenderingContext2D) {
        context.beginPath();
        context.moveTo(this.points[0].x, this.points[0].y);
        for (let i = 1; i < this.points.length - 1; i++) {
          const xc = (this.points[i].x + this.points[i + 1].x) / 2;
          const yc = (this.points[i].y + this.points[i + 1].y) / 2;
          context.quadraticCurveTo(this.points[i].x, this.points[i].y, xc, yc);
        }
        const last = this.points[this.points.length - 1];
        context.lineTo(last.x, last.y);
        context.strokeStyle = this.color;
        context.lineWidth = this.width;
        context.lineCap = "round";
        context.stroke();
      }
    }

    let ropes: Rope[] = [];
    let scale = 1;
    let rafId = 0;
    const mouse = { x: null as number | null, y: null as number | null, vx: 0, vy: 0, lastX: 0, lastY: 0 };

    function buildRopes() {
      ropes = CONFIG.ropes.map((r) => new Rope(r.xFraction * REFERENCE_WIDTH, r.points, r.spacing, r.width, r.hue));
    }

    function resize() {
      const rect = canvas!.getBoundingClientRect();
      scale = rect.width / REFERENCE_WIDTH;
      const dpr = window.devicePixelRatio || 1;
      canvas!.width = REFERENCE_WIDTH * dpr;
      canvas!.height = CANVAS_HEIGHT * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function onPointerMove(event: PointerEvent) {
      const rect = canvas!.getBoundingClientRect();
      const x = (event.clientX - rect.left) / scale;
      const y = (event.clientY - rect.top) / scale;
      mouse.vx = x - mouse.lastX;
      mouse.vy = y - mouse.lastY;
      mouse.x = x;
      mouse.y = y;
      mouse.lastX = x;
      mouse.lastY = y;
    }

    function tick() {
      ctx.clearRect(0, 0, REFERENCE_WIDTH, CANVAS_HEIGHT);
      ropes.forEach((rope) => {
        rope.update(mouse.x, mouse.y, mouse.vx, mouse.vy);
        rope.draw(ctx);
      });
      mouse.vx *= 0.9;
      mouse.vy *= 0.9;
      rafId = requestAnimationFrame(tick);
    }

    function start() {
      if (rafId) return;
      buildRopes();
      resize();
      window.addEventListener("pointermove", onPointerMove);
      window.addEventListener("resize", resize);
      rafId = requestAnimationFrame(tick);
    }

    function stop() {
      cancelAnimationFrame(rafId);
      rafId = 0;
      window.removeEventListener("pointermove", onPointerMove);
      window.removeEventListener("resize", resize);
    }

    function sync() {
      if (desktopQuery.matches && !reducedMotionQuery.matches) {
        start();
      } else {
        stop();
      }
    }

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stop();
      else sync();
    });

    desktopQuery.addEventListener("change", sync);
    reducedMotionQuery.addEventListener("change", sync);
    sync();
  }
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(32px, 6vw, 64px);
    padding: clamp(64px, 12vw, 180px) clamp(20px, 5vw, 80px) clamp(24px, 4vw, 64px);
    background: var(--bg-dark);
  }

  .doodle {
    position: absolute;
    left: -336.007px;
    top: -352.998px;
    width: 1836.929px;
    max-width: none;
    opacity: 0.6;
  }

  /* Desktop (>=1200px): the canvas rope simulation. Below that (and
     under prefers-reduced-motion), the static SVGs render instead — see
     the <script> above and DESIGN.md. */
  .liana-canvas {
    display: none;
    position: absolute;
    left: 0;
    top: -100px;
    width: 1728px;
    height: 650px;
    pointer-events: none;
  }

  .liana {
    position: absolute;
    pointer-events: none;
  }

  .liana img {
    max-width: none;
  }

  .liana-1 {
    left: -134.35px;
    top: -77.75px;
    width: 903.703px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .liana-1-rotate {
    width: 95%;
    transform: rotate(-6.44deg);
  }

  .liana-1-rotate img {
    width: 100%;
    height: auto;
  }

  .liana-2 {
    left: 842px;
    top: -87px;
    width: 122px;
  }

  .liana-2 img {
    width: 100%;
    height: auto;
  }

  .liana-3 {
    left: 1198px;
    top: -111px;
    width: 618px;
  }

  .liana-3 img {
    width: 100%;
    height: auto;
  }

  @media (min-width: 1200px) {
    .liana-canvas {
      display: block;
    }

    .liana-static {
      display: none;
    }
  }

  @media (min-width: 1200px) and (prefers-reduced-motion: reduce) {
    .liana-canvas {
      display: none;
    }

    .liana-static {
      display: block;
    }

    .liana-1.liana-static {
      display: flex;
    }
  }

  .content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(24px, 4vw, 40px);
    max-width: 1361px;
    width: 100%;
  }

  .text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(16px, 3vw, 32px);
  }

  h1 {
    font-family: var(--font-heading);
    font-size: clamp(3.5rem, 0.638rem + 12.72vw, 14.375rem);
    line-height: 0.78;
    letter-spacing: -0.05em;
    color: var(--text-heading-light);
    text-align: center;
    text-shadow: 0 0.06em 0 var(--bg-dark);
    transition:
      transform 0.15s ease,
      text-shadow 0.15s ease;
  }

  h1:hover {
    transform: translateY(0.06em);
    text-shadow: 0 0 0 var(--bg-dark);
  }

  @media (prefers-reduced-motion: reduce) {
    h1 {
      transition: none;
    }
  }

  .subtitle {
    max-width: 881px;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 24px;
    color: var(--text-body-light);
    text-align: center;
  }

  @media (max-width: 640px) {
    .doodle {
      display: none;
    }
  }
</style>
