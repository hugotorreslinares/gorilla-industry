---
import Button from "./Button.astro";
import ScrollIndicator from "./ScrollIndicator.astro";
import DecorFrame from "./DecorFrame.astro";
import LianaField from "./LianaField.astro";
import { useTranslations } from "../i18n/utils";

const t = useTranslations(Astro.currentLocale);
---

<section class="hero" id="hero">
  <DecorFrame>
    <img class="doodle" src="/images/hero-doodle.svg" alt="" aria-hidden="true" />

    <LianaField />

    <div class="liana liana-static liana-1" aria-hidden="true">
      <div class="liana-1-rotate">
        <img src="/images/liana-1.svg" alt="" />
      </div>
    </div>
    <img class="liana liana-static liana-2" src="/images/liana-2.svg" alt="" aria-hidden="true" />
    <img class="liana liana-static liana-3" src="/images/liana-3.svg" alt="" aria-hidden="true" />
  </DecorFrame>

  <div class="content">
    <div class="text">
      <h1>{t.hero.heading[0]}<br />{t.hero.heading[1]}</h1>
      <p class="subtitle">{t.hero.subtitle}</p>
    </div>
    <Button label={t.hero.cta} variant="onLight" />
  </div>

  <ScrollIndicator />
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(32px, 6vw, 64px);
    padding: clamp(64px, 12vw, 180px) clamp(20px, 5vw, 80px) clamp(24px, 4vw, 64px);
    background: var(--bg-dark);
  }

  .doodle {
    position: absolute;
    left: -336.007px;
    top: -352.998px;
    width: 1836.929px;
    max-width: none;
    opacity: 0.6;
  }

  .liana {
    position: absolute;
    z-index: 60;
    pointer-events: none;
  }

  .liana img {
    max-width: none;
  }

  .liana-1 {
    left: -134.35px;
    top: -77.75px;
    width: 903.703px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .liana-1-rotate {
    width: 95%;
    transform: rotate(-6.44deg);
  }

  .liana-1-rotate img {
    width: 100%;
    height: auto;
  }

  .liana-2 {
    left: 842px;
    top: -87px;
    width: 122px;
  }

  .liana-2 img {
    width: 100%;
    height: auto;
  }

  .liana-3 {
    left: 1198px;
    top: -111px;
    width: 618px;
  }

  .liana-3 img {
    width: 100%;
    height: auto;
  }

  /* Desktop (>=1200px): LianaField's own canvas simulation takes over
     (see that component). Below that, and under prefers-reduced-motion,
     these static SVGs stay visible instead. */
  @media (min-width: 1200px) {
    .liana-static {
      display: none;
    }
  }

  @media (min-width: 1200px) and (prefers-reduced-motion: reduce) {
    .liana-static {
      display: block;
    }

    .liana-1.liana-static {
      display: flex;
    }
  }

  .content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(24px, 4vw, 40px);
    max-width: 1361px;
    width: 100%;
  }

  .text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(16px, 3vw, 32px);
  }

  h1 {
    font-family: var(--font-heading);
    font-size: clamp(3.5rem, 0.638rem + 12.72vw, 14.375rem);
    line-height: 0.78;
    letter-spacing: -0.05em;
    color: var(--text-heading-light);
    text-align: center;
    text-shadow: 0 0.06em 0 var(--bg-dark);
    transition:
      transform 0.15s ease,
      text-shadow 0.15s ease;
  }

  h1:hover {
    transform: translateY(0.06em);
    text-shadow: 0 0 0 var(--bg-dark);
  }

  @media (prefers-reduced-motion: reduce) {
    h1 {
      transition: none;
    }
  }

  .subtitle {
    max-width: 881px;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 24px;
    color: var(--text-body-light);
    text-align: center;
  }

  @media (max-width: 640px) {
    .doodle {
      display: none;
    }
  }
</style>
