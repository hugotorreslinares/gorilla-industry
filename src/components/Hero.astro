---
import Button from "./Button.astro";
import ScrollIndicator from "./ScrollIndicator.astro";
import DecorFrame from "./DecorFrame.astro";
---

<section class="hero" id="hero">
  <DecorFrame>
    <img class="doodle" src="/images/hero-doodle.svg" alt="" aria-hidden="true" />

    <div class="liana liana-1" aria-hidden="true">
      <div class="liana-1-rotate">
        <img src="/images/liana-1.svg" alt="" />
      </div>
    </div>
    <img class="liana liana-2" src="/images/liana-2.svg" alt="" aria-hidden="true" />
    <img class="liana liana-3" src="/images/liana-3.svg" alt="" aria-hidden="true" />
  </DecorFrame>

  <div class="content">
    <div class="text">
      <h1>WE MAKE<br />BRANDS MOVE</h1>
      <p class="subtitle">
        We're Gorilla Industry — a branding and digital agency for brands that refuse to be forgettable. Strategy,
        identity and motion, built to turn heads.
      </p>
    </div>
    <Button label="START A PROJECT" variant="onLight" />
  </div>

  <ScrollIndicator />
</section>

<script>
  document.querySelectorAll<HTMLElement>(".hero .liana").forEach((liana) => {
    liana.addEventListener("pointerenter", () => {
      liana.classList.add("is-swaying");
    });
    liana.addEventListener("animationend", () => {
      liana.classList.remove("is-swaying");
    });
  });
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(32px, 6vw, 64px);
    padding: clamp(64px, 12vw, 180px) clamp(20px, 5vw, 80px) clamp(24px, 4vw, 64px);
    background: var(--bg-dark);
  }

  .doodle {
    position: absolute;
    left: -336.007px;
    top: -352.998px;
    width: 1836.929px;
    max-width: none;
    opacity: 0.6;
  }

  .liana {
    position: absolute;
    z-index: 60;
    pointer-events: auto;
  }

  .liana img {
    max-width: none;
  }

  .liana-1 {
    left: -134.35px;
    top: -77.75px;
    width: 903.703px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .liana-1-rotate {
    width: 95%;
    transform: rotate(-6.44deg);
    transform-origin: top center;
  }

  .liana-1.is-swaying .liana-1-rotate {
    animation: liana-sway-1 1.4s cubic-bezier(0.36, 0.07, 0.19, 0.97);
  }

  .liana-1-rotate img {
    width: 100%;
    height: auto;
  }

  .liana-2 {
    left: 842px;
    top: -87px;
    width: 122px;
    transform-origin: top center;
  }

  .liana-2 img {
    width: 100%;
    height: auto;
  }

  .liana-2.is-swaying {
    animation: liana-sway-2 0.8s cubic-bezier(0.36, 0.07, 0.19, 0.97);
  }

  .liana-3 {
    left: 1198px;
    top: -111px;
    width: 618px;
    transform-origin: top center;
  }

  .liana-3 img {
    width: 100%;
    height: auto;
  }

  .liana-3.is-swaying {
    animation: liana-sway-3 1.3s cubic-bezier(0.36, 0.07, 0.19, 0.97);
  }

  @keyframes liana-sway-2 {
    0% {
      transform: rotate(0deg) translateX(0);
    }
    15% {
      transform: rotate(10deg) translateX(4px);
    }
    35% {
      transform: rotate(-7deg) translateX(-3px);
    }
    55% {
      transform: rotate(5deg) translateX(2px);
    }
    72% {
      transform: rotate(-3deg) translateX(-1px);
    }
    88% {
      transform: rotate(1.5deg) translateX(0.5px);
    }
    100% {
      transform: rotate(0deg) translateX(0);
    }
  }

  @keyframes liana-sway-3 {
    0% {
      transform: rotate(0deg) scaleY(1);
    }
    25% {
      transform: rotate(-5deg) scaleY(1.015);
    }
    50% {
      transform: rotate(3deg) scaleY(0.99);
    }
    70% {
      transform: rotate(-2deg) scaleY(1.008);
    }
    87% {
      transform: rotate(1deg) scaleY(0.997);
    }
    100% {
      transform: rotate(0deg) scaleY(1);
    }
  }

  @keyframes liana-sway-1 {
    0% {
      transform: rotate(-6.44deg);
    }
    20% {
      transform: rotate(-1deg);
    }
    45% {
      transform: rotate(-11deg);
    }
    65% {
      transform: rotate(-4deg);
    }
    82% {
      transform: rotate(-8deg);
    }
    100% {
      transform: rotate(-6.44deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .liana.is-swaying,
    .liana-1.is-swaying .liana-1-rotate {
      animation: none;
    }
  }

  @media (max-width: 1200px) {
    .liana {
      display: none;
    }
  }

  .content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(24px, 4vw, 40px);
    max-width: 1361px;
    width: 100%;
  }

  .text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(16px, 3vw, 32px);
  }

  h1 {
    font-family: var(--font-heading);
    font-size: clamp(3.5rem, 0.638rem + 12.72vw, 14.375rem);
    line-height: 0.78;
    letter-spacing: -0.05em;
    color: var(--text-heading-light);
    text-align: center;
  }

  .subtitle {
    max-width: 881px;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 24px;
    color: var(--text-body-light);
    text-align: center;
  }

  @media (max-width: 640px) {
    .doodle {
      display: none;
    }
  }
</style>
